rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── JOGADORES ──────────────────────────────────────────────
    // Qualquer um lê. Apenas usuário autenticado escreve.
    match /jogadores/{id} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── RODADAS ────────────────────────────────────────────────
    // Qualquer um lê. Apenas usuário autenticado escreve.
    match /rodadas/{id} {
      allow read:  if true;
      allow write: if request.auth != null;
    }
  }
}
